  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpXLib\McpXLib.csproj" />
    <ProjectReference Include="..\McpXInterop\McpXInterop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 偽 PLC（TestMcpX と共有） -->
    <Compile Include="..\TestMcpX\FakePlcTransport.cs" Link="FakePlcTransport.cs" />
  </ItemGroup>

</Project>
